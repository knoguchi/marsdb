WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

query = { SOI ~ statement ~ ";"? ~ EOI }

// A `;`-separated batch of statements — `parse_many` uses this, `parse`
// (single-statement) still uses `query` above unchanged. `;` only ever
// separates `statement`s here; a `;` inside a `string_literal` is
// consumed as part of that atomic rule and never reaches this level, so
// no special-casing is needed to avoid splitting inside a string.
queries = { SOI ~ statement ~ (";" ~ statement)* ~ ";"? ~ EOI }

// `create_index_stmt` tried before `create_stmt` -- both start with
// `^"CREATE"`, but `pattern` always starts with `(`, never `INDEX`, so
// ordered choice backtracks cleanly on a plain `CREATE (...)`. `explain_stmt`
// tried first of all -- it's the only rule starting with `EXPLAIN`, so there's
// no backtracking concern, just an ordinary prefix check. `union_stmt` tried
// before plain `match_stmt` -- both start by parsing one `match_stmt`, but
// `union_stmt` additionally requires at least one trailing `UNION [ALL]
// match_stmt`; if that's absent, pest backtracks cleanly onto plain
// `match_stmt` (same ordered-choice-with-backtracking reasoning as
// `create_index_stmt`/`create_stmt` above), at the cost of reparsing the
// first part once on a non-UNION statement -- a normal, cheap PEG tradeoff.
statement = { explain_stmt | create_index_stmt | create_stmt | union_stmt | match_stmt }

// `EXPLAIN <statement>` -- never wraps another `explain_stmt` (real Cypher's
// own `EXPLAIN EXPLAIN ...` isn't valid either), so the inner alternative
// list deliberately excludes it rather than reusing `statement` itself.
// `union_stmt` before `match_stmt` here for the same backtracking reason
// `statement`'s own alternation needs it.
explain_stmt = { ^"EXPLAIN" ~ (create_index_stmt | create_stmt | union_stmt | match_stmt) }

// `RETURN 1 AS x UNION RETURN 2 AS x` / `... UNION ALL ...` -- each part is
// an independent `match_stmt` (own scope, no bindings shared across parts,
// matching real Cypher), concatenated. Whether every part actually used
// `ALL` consistently (real Cypher rejects mixing `UNION` and `UNION ALL` in
// one statement) and whether every part's column list actually matches are
// both semantic checks (`parser.rs::parse_union_stmt`/`executor::
// materialize_union`), not grammar-level restrictions -- both are only
// checkable after parsing, once real column names/`all`-flags are in hand.
union_stmt = { match_stmt ~ (union_op ~ match_stmt)+ }
union_op   = { ^"UNION" ~ all_kw? }
all_kw     = { ^"ALL" }

create_stmt = { ^"CREATE" ~ pattern ~ ("," ~ pattern)* }

// `CREATE INDEX ON :Label(prop)`, optionally `UNIQUE` -- deliberately the
// older, simpler single-property syntax (not the newer `CREATE INDEX FOR
// (n:Label) ON (n.prop)` form, and not real Cypher's separate `CREATE
// CONSTRAINT ... IS UNIQUE`) -- narrowly enough scoped to declare exactly
// what `GraphStore::create_index` supports today (one label, one
// property), not a general multi-property/constraint DDL surface.
create_index_stmt = { ^"CREATE" ~ ^"INDEX" ~ ^"ON" ~ ":" ~ identifier ~ "(" ~ identifier ~ ")" ~ unique_kw? }
unique_kw = { ^"UNIQUE" }

// `clause*`, not `clause+` -- a bare `RETURN <expr>` with no MATCH/UNWIND/
// MERGE at all (e.g. `RETURN 1 + 1`) is valid real Cypher, needing no
// graph access. tail_clause is separately optional -- a bare `MERGE (...)`
// with nothing after it is valid, same as standalone CREATE (see
// parser.rs::parse_match_stmt for the "tail required unless a MERGE
// clause is present" check, which already handles the zero-clause case
// correctly as-is: no clauses means no MERGE among them, so a tail is
// required, exactly as it should be).
match_stmt    = { clause* ~ tail_clause? ~ order_by_clause? ~ skip_clause? ~ limit_clause? }
// `with_clause` here (not just as `match_part`'s own trailing suffix) is
// what lets a statement *start* with `WITH <expr> AS x ...` -- real
// Cypher allows this (e.g. `WITH [1,2,3] AS list RETURN list[1..3]`, the
// exact shape most of the TCK's list scenarios use), needing no MATCH at
// all since it's just projecting/aliasing values, not reading the graph.
clause        = { unwind_clause | merge_clause | with_clause | match_part }
match_part    = { match_keyword ~ path_pattern ~ ("," ~ pattern)* ~ where_clause? ~ with_clause? }
match_keyword = { (^"OPTIONAL" ~ ^"MATCH") | ^"MATCH" }

// `p = (a)-->(b)` (named-path capture) or `p = shortestPath((a)-[:T*..N]-(b))`
// -- only the match_part's *first* pattern token can carry a name; any
// comma-continuation after it (spliced by parser::splice_patterns) is a
// plain `pattern`, same as today, since naming/shortestPath only make
// sense for the whole matched shape, not a fragment of it.
path_pattern          = { (identifier ~ "=")? ~ (shortest_path_wrapper | pattern) }
shortest_path_wrapper = { ^"shortestPath" ~ "(" ~ pattern ~ ")" }
with_clause   = { ^"WITH" ~ return_item ~ ("," ~ return_item)* ~ with_where_clause? ~ order_by_clause? ~ skip_clause? ~ limit_clause? }

// Not a general `Literal::List` usable anywhere a `literal` is (a prop
// value, a comparison RHS, ...) — deliberately scoped to only appear right
// after UNWIND, same reasoning as `with_comparison`'s deliberately-separate
// mirror of `comparison` elsewhere in this grammar.
// Its filter reuses `with_where_clause` (a `with_expr`, LHS is a
// `return_expr`), not the pattern-level `where_clause`/`expr`
// (`comparison`'s LHS is always a `prop_access`) -- an UNWIND-bound
// variable is very often a bare scalar (`UNWIND [1,2,3] AS x WHERE x >
// 2`), which `comparison` structurally cannot express at all (only
// `x.prop > 2` is representable there).
// Any expression, not just a literal list/null/bound variable -- real
// Cypher's UNWIND source can be `range(0, 2)`, `n.tags`, `[x IN y | x]`,
// etc. `return_expr` already covers the old three forms as special cases
// (a list literal is `list_expr`, `null` is part of `literal`, a bound
// variable is `identifier` -- all reachable through `atom_expr`), so this
// is a strict widening, not a new grammar shape.
unwind_clause = { ^"UNWIND" ~ unwind_source ~ ^"AS" ~ identifier ~ with_where_clause? ~ with_clause? }
unwind_source = { return_expr }

// No WHERE here -- real Cypher's MERGE has none either; the pattern's own
// labels/props are the only match criteria. `pattern`'s hop count is
// capped at 1 in parser.rs (whole-pattern atomicity across multiple
// simultaneously-unbound hops isn't attempted in v1 -- see
// executor::eval_merge's docs).
merge_clause      = { ^"MERGE" ~ pattern ~ on_create_clause? ~ on_match_clause? ~ with_clause? }
on_create_clause  = { ^"ON" ~ ^"CREATE" ~ ^"SET" ~ set_item ~ ("," ~ set_item)* }
on_match_clause   = { ^"ON" ~ ^"MATCH" ~ ^"SET" ~ set_item ~ ("," ~ set_item)* }

// Reuses `create_stmt` itself (not a duplicate rule) — a `MATCH ... CREATE`
// tail has the exact same pattern syntax as a standalone `CREATE`
// statement; only the AST/executor treat a node token whose variable is
// already bound differently (reuse the existing node instead of making a
// new one — see `Tail::Create`'s docs).
// `return_clause` is tried first: with no leading keyword of its own
// besides `RETURN`, there's no ambiguity with `mutating_tail` (which always
// starts with DETACH/DELETE/REMOVE/SET/CREATE instead), so choice order
// here doesn't matter for correctness -- just avoids one extra failed
// alternative on the (more common) plain `RETURN ...` tail.
tail_clause = { return_clause | mutating_tail }
// A mutating tail clause optionally followed by one trailing `RETURN` —
// real Cypher (`MATCH (n) SET n.x = 1 RETURN n`). Only this one shape is
// supported (a single mutating clause, then a single optional RETURN) —
// arbitrary chaining (multiple mutating clauses, or a WITH between the
// mutation and the RETURN) isn't attempted here; see `Tail::Delete`'s docs.
mutating_tail = { (detach_delete_clause | delete_clause | remove_clause | set_clause | create_stmt) ~ return_clause? }

return_clause = { ^"RETURN" ~ distinct_kw? ~ return_item ~ ("," ~ return_item)* }
return_item   = { return_expr ~ (^"AS" ~ identifier)? }
// Full precedence chain, loosest to tightest: `OR` < `XOR` < `AND` <
// `NOT` < a single comparison < `+`/`-` < `*`/`/`/`%` < postfix
// (`[...]`) < atom. `return_expr` stays the name every other rule
// threads an expression through (call_args, case_when, sort_item, ...)
// -- only its own production changed, this time to grow the boolean/
// comparison layers above the pre-existing arithmetic chain.
return_expr   = { bool_or_expr }
bool_or_expr  = { bool_xor_expr ~ (kw_or ~ bool_xor_expr)* }
bool_xor_expr = { bool_and_expr ~ (kw_xor ~ bool_and_expr)* }
bool_and_expr = { bool_not_expr ~ (kw_and ~ bool_not_expr)* }
// Right-recursive (`NOT NOT x` is valid), not `NOT*` -- avoids a
// separate repeat-then-fold step for what's already naturally a chain.
bool_not_expr = { (kw_not ~ bool_not_expr) | compare_expr }
// A bare `^"OR"`/`^"AND"`/`^"XOR"`/`^"NOT"` has no word-boundary check --
// `^"OR"` alone would happily match the first two letters of `ORDER`,
// leaving `DER` to parse as a bogus right-hand identifier and silently
// mis-parsing `RETURN y ORDER BY y` as `RETURN (y OR DER)` followed by a
// now-nonsensical `BY y` (a real regression this exact chain introduced
// and a real TCK/smoke-test failure caught). `@` (atomic) so no implicit
// whitespace gets inserted before the lookahead -- otherwise `AND true`
// would consume the space first and check the lookahead against `t`
// (alphanumeric), wrongly rejecting the legitimate keyword too. Atomic
// rules still produce their own `Pair` (can't also be silent), so
// `parse_bool_or_expr`/`_xor_expr`/`_and_expr` filter these out rather
// than assuming `.into_inner()` alternates purely with the operand rule.
kw_or  = @{ ^"OR" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_xor = @{ ^"XOR" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_and = @{ ^"AND" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_not = @{ ^"NOT" ~ !(ASCII_ALPHANUMERIC | "_") }
// Same word-boundary reasoning as `kw_or`/etc above -- `IS`/`NULL` are
// short enough to realistically prefix a real identifier/property name
// (`island`, `nullable`, ...).
kw_is   = @{ ^"IS" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_null = @{ ^"NULL" ~ !(ASCII_ALPHANUMERIC | "_") }
// A chain of 1+ comparisons (`1 < x < 10`), or a single `IS [NOT] NULL`
// check -- never both on the same operand (real Cypher doesn't chain
// IS NULL with a comparison operator either). The chain-vs-single-op
// distinction is resolved in `parser.rs` (fold adjacent pairs with AND),
// not here.
compare_expr    = { add_expr ~ ((compare_op ~ add_expr)+ | is_null_suffix)? }
is_null_suffix  = { kw_is ~ kw_not? ~ kw_null }
add_expr    = { mul_expr ~ (add_op ~ mul_expr)* }
add_op      = { "+" | "-" }
mul_expr    = { postfix_expr ~ (mul_op ~ postfix_expr)* }
mul_op      = { "*" | "/" | "%" }
// `[...]` binds tighter than `*`/`/`/`%` -- `list[0] * 2` indexes first,
// then multiplies -- and chains (`[[1]][0][0]`), via the `*` repeat.
// `index_or_slice`'s two forms (`slice_range` vs a single index
// `return_expr`) share one `[...]` wrapper: PEG ordered choice tries
// `slice_range` first, which requires an actual `..` to match at all, so
// a plain `list[i]` cleanly falls through to the `return_expr` (single
// index) alternative instead.
postfix_expr    = { atom_expr ~ index_or_slice* }
index_or_slice  = { "[" ~ (slice_range | return_expr) ~ "]" }
slice_range     = { return_expr? ~ ".." ~ return_expr? }
// Order matters: case_expr/function_call/prop_access need their extra
// syntax tried before the bare `identifier` fallback, and `literal` must
// come before `identifier` too — otherwise the keywords true/false/null
// would parse as plain variable references instead of literals. The
// parenthesized form (`(` ~ return_expr ~ `)`) is the only way to
// override precedence explicitly, e.g. `(a + b) * c`.
// `list_expr` (a general expression list, `[a, b+1, f(x)]`) is tried
// before `literal`/`identifier` -- unambiguous either way since it starts
// with `[`, which nothing else here can, but keeping the ordering
// consistent with this rule's own "more specific syntax first" pattern.
// `quantifier_expr` (`ALL(x IN list WHERE cond)`) is tried before
// `function_call` -- both start with `identifier ~ "("`, but ordered
// choice backtracks cleanly: `call_args` (a comma-separated return_expr
// list) can never match `x IN list WHERE cond`'s shape (`IN`/`WHERE`
// aren't valid `return_expr` continuations), so a real function call
// falls through to `function_call` untouched.
// `map_expr` (`{a: 1, b: 2+1}`) is unambiguous against everything else
// here -- `{` starts nothing else `atom_expr` can produce.
// `label_check_expr` (`(n:Foo)`, `(n:Foo:Bar)` -- true iff the bound node
// has every listed label) is tried before the generic parenthesized-
// grouping alternative -- both start with `"(" ~ identifier`, but
// `return_expr` has no production starting with `identifier ~ ":"`
// (`map_expr`'s `key: value` shape only ever appears after a `{`), so
// ordered choice backtracks cleanly onto plain grouping otherwise.
// `qualified_function_call` before `prop_access` -- both start with
// `identifier "." identifier`, but only the former is followed by `(`.
// `function_call` itself can't match `duration.between(...)`'s dotted
// name (its own `identifier` stops at the `.`, then expects `(` and
// fails), so ordered choice backtracks past it too.
atom_expr   = { case_expr | quantifier_expr | function_call | qualified_function_call | list_expr | map_expr | prop_access | literal | identifier | label_check_expr | ("(" ~ return_expr ~ ")") }
// `duration.between(a, b)`/`.inDays(...)`/`.inMonths(...)`/
// `.inSeconds(...)`, `date.truncate(...)`/etc -- Cypher's namespaced
// temporal functions. Reuses `call_args` (no `*`/`DISTINCT` are
// meaningful here, but rejecting that is a parser.rs semantic check,
// not a grammar restriction, matching this codebase's existing
// `function_call` precedent).
qualified_function_call = { identifier ~ "." ~ identifier ~ "(" ~ call_args ~ ")" }
label_check_expr = { "(" ~ identifier ~ (":" ~ identifier)+ ~ ")" }
// The *same* rule (not a near-duplicate) as a node/relationship's `{...}`
// property map below -- `map_expr`/`map_kv` is reused there too (see
// `node_pattern`), since a `CREATE`/`MERGE` prop value can be any
// `return_expr` (e.g. `CREATE (:Val {date: date({year: 1984, ...})})`),
// not just a bare `literal` -- `MATCH`/`MERGE`'s own inline pattern props
// are further restricted back down to literals at plan-build time
// instead (`planner::require_literal_pattern_prop`), not by the grammar.
map_expr    = { "{" ~ (map_kv ~ ("," ~ map_kv)*)? ~ "}" }
map_kv      = { identifier ~ ":" ~ return_expr }
// `list_comprehension` (`[x IN list WHERE cond | expr]`) is tried before
// the plain comma-separated form -- ordered choice backtracks cleanly:
// a plain list's first element only looks like a comprehension's bound
// variable if it's a bare identifier immediately followed by `IN`, which
// a plain element list (`[a, b]`, `[a.name]`, `[f(x)]`, ...) never is.
list_expr           = { "[" ~ (list_comprehension | (return_expr ~ ("," ~ return_expr)*)?) ~ "]" }
list_comprehension  = { filter_expr ~ ("|" ~ return_expr)? }
// Shared by `list_comprehension` and `quantifier_expr` -- both bind one
// variable over a list, optionally filtered. WHERE is a plain
// `return_expr` (not the pattern-level `where_clause`/`expr`, nor
// `with_expr`) -- now that boolean logic/comparisons are real
// `return_expr` productions, this is strictly wider than `with_expr` was
// (a bare `WHERE x`/`WHERE true` parses, where `with_expr` only ever
// accepted a `Compare`), and the bound variable is very often a bare
// scalar/node/edge anyway, not something `comparison`'s
// `prop_access`-only LHS could express even before this.
filter_expr         = { identifier ~ ^"IN" ~ return_expr ~ (^"WHERE" ~ return_expr)? }
quantifier_expr      = { quantifier_kw ~ "(" ~ filter_expr ~ ")" }
quantifier_kw        = { ^"ALL" | ^"ANY" | ^"NONE" | ^"SINGLE" }

case_expr     = { ^"CASE" ~ return_expr ~ case_when+ ~ (^"ELSE" ~ return_expr)? ~ ^"END" }
case_when     = { ^"WHEN" ~ return_expr ~ ^"THEN" ~ return_expr }
function_call = { identifier ~ "(" ~ call_args ~ ")" }
// `"*"` (bare, only meaningful for `count(*)`) is tried first — no
// `return_expr` production can ever start with a bare `*`, so there's no
// backtracking ambiguity with the general-args branch. Which functions
// accept `"*"` or `DISTINCT` is a semantic check in parser.rs, not a
// grammar-level restriction — see cypher.pest's other permissive-grammar
// precedents (comma-pattern splicing, WITH-boundary counting).
call_args     = { "*" | (distinct_kw? ~ (return_expr ~ ("," ~ return_expr)*)?) }
distinct_kw   = { ^"DISTINCT" }

// WITH's HAVING-equivalent: filters on the already-projected/aggregated
// row, so its comparison LHS is a `return_expr` (a WITH alias or raw
// expression), not `prop_access` like pattern-level `comparison` below —
// structurally a separate mirror of expr/and_expr/or_expr, not a reuse of
// them, since widening pattern-`Expr`'s LHS type would ripple into the
// planner's pre-projection filter-pushdown logic for a WHERE that
// fundamentally belongs post-projection instead.
with_where_clause = { ^"WHERE" ~ with_expr }
with_expr         = { with_or_expr }
with_or_expr      = { with_and_expr ~ (^"OR" ~ with_and_expr)* }
with_and_expr     = { with_unary_expr ~ (^"AND" ~ with_unary_expr)* }
// `with_is_null_expr` tried before `with_comparison` -- both start with
// `add_expr`, but `with_comparison` requires a `compare_op` to follow,
// which `kw_is` never is, so ordered choice backtracks cleanly.
with_unary_expr   = { (^"NOT" ~ with_unary_expr) | with_is_null_expr | with_comparison | ("(" ~ with_expr ~ ")") }
// `x IS NULL` / `x IS NOT NULL` where `x` is any `add_expr`, not just a
// property access -- real Cypher's WITH...WHERE needs this for a whole
// bound var (`WHERE r IS NULL`, checking an OPTIONAL MATCH miss), not
// just `n.prop IS NULL`.
with_is_null_expr = { add_expr ~ is_null_suffix }
// `add_expr` on both sides, not `return_expr` -- `return_expr` now
// includes its own optional trailing comparison (`compare_expr`), so
// using it here would let either side greedily consume the whole
// `lhs op rhs` shape itself (`y > 10` fully parses as one `return_expr`),
// leaving nothing for this rule's own `compare_op` to match. `add_expr`
// is the same arithmetic-only layer real Cypher's own grammar puts on a
// comparison's operands anyway (a comparison's operand is never itself
// another comparison without explicit parens). RHS used to be a plain
// `literal` -- too narrow for real Cypher's `WITH ... WHERE a = b`
// (comparing two bound variables/properties, not one against a constant),
// so it's `add_expr` too now, same as pattern-level `Expr::Compare` needed
// widening for chained comparisons.
with_comparison   = { add_expr ~ compare_op ~ add_expr }

// Any expression, not just a bare identifier -- real Cypher's DELETE
// target can be `list[0]`, `map.key`, a whole named path (deletes every
// node/edge in it), etc. (`executor::materialize_delete`/`delete_value`).
detach_delete_clause = { ^"DETACH" ~ ^"DELETE" ~ return_expr ~ ("," ~ return_expr)* }
delete_clause         = { ^"DELETE" ~ return_expr ~ ("," ~ return_expr)* }
// Order matters: `prop_access` (`n.prop`) is tried first -- both start with
// an `identifier`, and only backtrack to `set_label_item` (`n:Label`) if
// the "." doesn't match. RHS is a full `return_expr` (not `literal`) --
// real Cypher's SET value can be any expression (`SET n.name = n.name +
// ' was here'`), same as `CREATE`'s own inline `{...}` prop values
// already are (`map_expr`/`Executor::eval_props_to_values`).
set_clause     = { ^"SET" ~ set_item ~ ("," ~ set_item)* }
set_item       = { (prop_access ~ "=" ~ return_expr) | set_label_item }
set_label_item = { identifier ~ (":" ~ identifier)+ }

remove_clause   = { ^"REMOVE" ~ remove_item ~ ("," ~ remove_item)* }
remove_item     = { prop_access | set_label_item }

where_clause    = { ^"WHERE" ~ expr }
limit_clause    = { ^"LIMIT" ~ int_literal }
skip_clause     = { ^"SKIP" ~ int_literal }
order_by_clause = { ^"ORDER" ~ ^"BY" ~ sort_item ~ ("," ~ sort_item)* }
sort_item       = { return_expr ~ sort_dir? }
sort_dir        = { ^"ASC" | ^"DESC" }

pattern = { node_pattern ~ (rel_pattern ~ node_pattern)* }

node_pattern = { "(" ~ node_var? ~ node_label* ~ map_expr? ~ ")" }
node_var     = { identifier }
node_label   = { ":" ~ identifier }

// Order matters: rel_right's trailing "->" must be tried before rel_either's
// bare "-", or "-[:KNOWS]->" would parse as rel_either and leave a dangling
// ">" that fails the rest of the pattern instead of matching rel_right. Same
// reasoning for the bracketless forms below: rel_right_bare's "-->" must be
// tried before rel_either_bare's bare "--", or "-->(b)" would match "--" and
// leave a dangling ">". The bracketed and bracketless alternatives don't
// conflict with each other (second character is always "[" vs "-"/">"), so
// their relative order doesn't matter.
rel_pattern     = { rel_right | rel_left | rel_either | rel_right_bare | rel_left_bare | rel_either_bare }
rel_right       = { "-[" ~ rel_var? ~ rel_type? ~ rel_range? ~ map_expr? ~ "]->" }
rel_left        = { "<-[" ~ rel_var? ~ rel_type? ~ rel_range? ~ map_expr? ~ "]-" }
rel_either      = { "-[" ~ rel_var? ~ rel_type? ~ rel_range? ~ map_expr? ~ "]-" }
// `-->`/`<--`/`--` -- the bracketless shorthand for an anonymous,
// untyped, propertyless relationship (real Cypher: brackets are only
// needed at all to carry a var/type/range/props). No inner pairs, so
// `parse_rel_pattern`'s child loop below runs zero times for these,
// producing a `RelPattern` identical to `-[]->`/`<-[]-`/`-[]-`.
rel_right_bare  = { "-->" }
rel_left_bare   = { "<--" }
rel_either_bare = { "--" }
rel_var     = { identifier }
rel_type    = { ":" ~ identifier }
// Variable-length hop count: `*`, `*N`, `*N..`, `*N..M`, `*..M`. Captured
// as raw text and parsed directly in parser.rs rather than broken into
// sub-rules — simpler than distinguishing "*N" (exact) from "*N.." (N or
// more) structurally, since the ".." literal itself produces no Pair.
rel_range = @{ "*" ~ ASCII_DIGIT* ~ (".." ~ ASCII_DIGIT*)? }

// A node/relationship's `{...}` property map is exactly `map_expr` (see
// its docs above, next to `atom_expr`) -- evaluated per-row at CREATE
// time (`Executor::eval_props_to_values`) the same way any other
// `return_expr` is, not restricted to literal-only values.

expr       = { or_expr }
or_expr    = { and_expr ~ (^"OR" ~ and_expr)* }
and_expr   = { unary_expr ~ (^"AND" ~ unary_expr)* }
// `is_null_expr` tried before `comparison` -- both start with
// `prop_access`, but `comparison` requires a `compare_op` to follow,
// which `kw_is` never is, so ordered choice backtracks cleanly.
// `label_predicate`/`var_compare` both start with a bare `identifier`
// (no dot) -- tried after `comparison`/`is_null_expr` (which require a
// dot) so ordered choice backtracks cleanly off the missing dot, then
// distinguishes on `:` (label_predicate) vs a `compare_op` (var_compare).
unary_expr    = { (^"NOT" ~ unary_expr) | is_null_expr | comparison | label_predicate | var_compare | ("(" ~ expr ~ ")") }
// RHS is `prop_access` too, not just `literal` -- real Cypher's WHERE
// routinely compares two properties (`a.id = b.id`), not just a property
// against a constant. Only the `literal` shape is eligible for the
// planner's index-seek fusion (see planner.rs); a `prop_access` RHS
// always falls back to `Expr::PropCompare`, a generic post-scan filter.
comparison    = { prop_access ~ compare_op ~ (prop_access | literal) }
is_null_expr  = { prop_access ~ is_null_suffix }
// `a:A`, `a:A:B` -- a bare variable followed by one or more labels,
// same shape as `set_label_item`. Desugars in parser.rs to a chain of
// `Expr::HasLabel`, `And`-ed together for the multi-label case.
label_predicate = { identifier ~ (":" ~ identifier)+ }
// `a = b` / `a <> b` -- node/relationship identity comparison (real
// Cypher's `Expr::VarEq`/`Not(VarEq)`); only `=`/`<>` are meaningful for
// identity (no ordering exists between two nodes), enforced in
// parser.rs, not the grammar.
var_compare = { identifier ~ compare_op ~ identifier }
compare_op = { "<>" | "<=" | ">=" | "=" | "<" | ">" | (^"STARTS" ~ ^"WITH") | (^"ENDS" ~ ^"WITH") | ^"CONTAINS" }

prop_access = { identifier ~ "." ~ identifier }

literal        = { float_literal | int_literal | string_literal | bool_literal | null_literal | param }
int_literal    = @{ "-"? ~ ASCII_DIGIT+ }
float_literal  = @{ "-"? ~ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }
// `\` escapes the next character (so `\'` doesn't terminate the string
// early -- without this, `(!"'" ~ ANY)*` has no concept of escaping and
// `'it\'s'` silently mis-terminates at the escaped quote instead of
// erroring, leaving a dangling `s'` that breaks whatever follows with a
// confusing, seemingly-unrelated parse error). Which escapes are
// recognized (`\\ \' \" \n \r \t \b \f`) is checked in parser.rs, not
// here -- this rule accepts any `\`-prefixed char permissively, same
// precedent as this grammar's other permissive/semantic-check-in-Rust
// rules (see call_args's DISTINCT-validity comment).
string_literal = @{ "'" ~ (escaped_char | (!("'" | "\\") ~ ANY))* ~ "'" }
escaped_char   =  { "\\" ~ ANY }
bool_literal   = @{ ^"true" | ^"false" }
null_literal   = @{ ^"null" }
param          = { "$" ~ identifier }

identifier = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
